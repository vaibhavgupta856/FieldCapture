<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Initialising…"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lastCommandText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Say: capture nameplate | capture damage [room] [surface] | note: text" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnEnableMock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 Enable MDK" />
            <Button android:id="@+id/btnPair" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 Pair" />
            <Button android:id="@+id/btnReady" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 Power/Don/Unfold" />
            <Button android:id="@+id/btnFeed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 Feed: phone cam" />
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/btnStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start walk" />
            <Button android:id="@+id/btnPause" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pause" />
            <Button android:id="@+id/btnResume" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resume" />
            <Button android:id="@+id/btnStop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stop walk" />
            <Button android:id="@+id/btnDrop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Simulate drop" />
            <Button android:id="@+id/btnOffline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline: OFF" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button android:id="@+id/btnListen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start listening" />
        <Button android:id="@+id/btnSync" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sync now" />
        <Button android:id="@+id/btnExport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Export jobs" />
    </LinearLayout>

    <TextView
        android:id="@+id/queueText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Queue: 0" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:background="#FFF3F5F8">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:padding="8dp" />
    </ScrollView>
</LinearLayout>
